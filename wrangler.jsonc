{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-rely-backend3",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "APP_ENV": "production",
    "LOG_FILE_ENABLED": "false",
    "LOG_PRETTY_FILE_ENABLED": "false",
    "DEV_AUTH_BYPASS_ENABLED": "false"
  },
  "containers": [
    {
      "name": "chat-rely-backend3-backendcontainer",
      "class_name": "BackendContainer",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "max_instances": 10,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "BackendContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackendContainer"]
    }
  ]
}
